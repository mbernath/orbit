{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Control centre for AI agents across several workspaces",
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "hooks:install": "bun scripts/install-hooks.ts",
    "hooks:uninstall": "bun scripts/install-hooks.ts --uninstall",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "verify": "tsc -p . && bun test",
    "test:e2e": "playwright test",
    "fresh": "bun scripts/fresh.ts",
    "media": "bun scripts/readme-media/capture.ts"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/bun": "1.3.4",
    "typescript": "5.9.3"
  }
}
